    <text>Now the paper data in [index.html](index.html): the four new entries, the venue updates, the "just planted" move and the Reading branch rename.</text>
    <tool name="terminal" command="python3 - &lt;&lt;'EOF'
p='index.html'
s=open(p).read()
def rep(old,new,count=1):
    global s
    assert s.count(old)==count, (old, s.count(old))
    s=s.replace(old,new)

# DELEGATE52 -&gt; COLM2026, no longer latest
rep('data-id=&quot;delegate52&quot; data-title=&quot;DELEGATE52&quot; data-venue=&quot;arxiv&quot;','data-id=&quot;delegate52&quot; data-title=&quot;DELEGATE52&quot; data-venue=&quot;COLM2026&quot;')
rep('data-url=&quot;https://arxiv.org/abs/2604.15597&quot; data-parent=&quot;lost_in_conv&quot; data-latest=&quot;1&quot;','data-url=&quot;https://arxiv.org/abs/2604.15597&quot; data-parent=&quot;lost_in_conv&quot;')

# Evolving intent: between DELEGATE52 and UserLM (middle child of Lost in Conversation)
evolving = '''        &lt;article class=&quot;paper-entry&quot; data-id=&quot;evolving_intent&quot; data-title=&quot;Evolving User Intent&quot; data-venue=&quot;arXiv&quot;
            data-url=&quot;https://arxiv.org/abs/2607.20734&quot; data-parent=&quot;lost_in_conv&quot;
            data-coauthors=&quot;Jihoon Tack, Jennifer Neville&quot;
            data-full-title=&quot;LLMs Get Lost in Evolving User Intent&quot;
            data-summary=&quot;Work led by Jihoon Tack, a follow-up to Lost in Conversation. In real conversations, users don't just reveal their intent piece by piece: they also revise it, and sometimes change direction entirely. We build a framework that turns existing single-turn tasks into multi-turn conversations where the user's intent evolves, while keeping each task's original evaluation (no new annotation needed!). Neat Finding: strong single-turn performance does not transfer. Models across families show large drops once the intent evolves, and struggle to keep track of what the user currently wants.&quot;&gt;
        &lt;/article&gt;

'''
rep('        &lt;article class=&quot;paper-entry&quot; data-id=&quot;userlm&quot;', evolving + '        &lt;article class=&quot;paper-entry&quot; data-id=&quot;userlm&quot;')

# UserLM-2.0 after UserLM, gets the &quot;just planted&quot; sign
userlm2 = '''
        &lt;article class=&quot;paper-entry&quot; data-id=&quot;userlm2&quot; data-title=&quot;UserLM-2.0&quot; data-venue=&quot;arXiv&quot;
            data-url=&quot;https://arxiv.org/abs/2610.31512&quot; data-parent=&quot;userlm&quot; data-latest=&quot;1&quot;
            data-coauthors=&quot;Mustafa Omer Gul, Tanya Goyal, Jennifer Neville&quot;
            data-full-title=&quot;Towards User Simulators That Stay On Task And Still Sound Natural&quot;
            data-summary=&quot;Work led by Omer Gul, the sequel to UserLM. User simulators face a tradeoff: prompted assistants stay on task but don't sound like real users, while specialized simulators (like UserLM-8b) sound natural but drift away from complex intents. We propose an RL recipe that jointly rewards intent adherence and naturalness, with naturalness measured by a lightweight discriminator trained adversarially alongside the simulator. Neat Finding: the resulting UserLM-2.0 produces valid conversations (on task AND natural) 46.2% of the time, vs. 14.1% for the strongest prior user simulator.&quot;&gt;
        &lt;/article&gt;
'''
anchor = '            data-links-model=&quot;https://huggingface.co/microsoft/UserLM-8b&quot;&gt;\n        &lt;/article&gt;\n'
rep(anchor, anchor + userlm2)

# AI-Slop to AI-Polish -&gt; COLM2025
rep('data-id=&quot;writing_quality_reward_models&quot; data-title=&quot;Writing Quality Reward Models&quot; data-venue=&quot;arXiv&quot;','data-id=&quot;writing_quality_reward_models&quot; data-title=&quot;Writing Quality Reward Models&quot; data-venue=&quot;COLM2025&quot;')

# DeepTRACE after Answer Engine Eval
deeptrace = '''
        &lt;article class=&quot;paper-entry&quot; data-id=&quot;deeptrace&quot; data-title=&quot;DeepTRACE&quot; data-venue=&quot;ICLR2026&quot;
            data-url=&quot;https://arxiv.org/abs/2509.04499&quot; data-parent=&quot;answer_engine_eval&quot;
            data-coauthors=&quot;Pranav Narayanan Venkit, Yilun Zhou, Kung-Hsiang Huang, Yixin Mao, Chien-Sheng Wu&quot;
            data-full-title=&quot;DeepTRACE: Auditing Deep Research AI Systems for Tracking Reliability Across Citations and Evidence&quot;
            data-summary=&quot;Work led by Pranav Venkit, a follow-up to Answer Engine Eval. We turn the failure cases identified in the earlier qualitative study into an automated audit framework with eight measurable dimensions (covering the answer text, its sources, and its citations), built on statement-level decomposition and citation/factual-support matrices. We audit generative search and deep research systems (GPT-5, Perplexity, Copilot, Gemini, You.com). Neat Finding: deep research modes reduce overconfidence and cite thoroughly, but remain one-sided on debate questions and still contain many statements unsupported by their own sources: citation accuracy ranges from 40% to 80% across systems.&quot;&gt;
        &lt;/article&gt;
'''
anchor = '            data-links-code=&quot;https://github.com/SalesforceAIResearch/answer-engine-eval&quot;&gt;\n        &lt;/article&gt;\n'
rep(anchor, anchor + deeptrace)

# Reading branch now continues
rep('data-root-name=&quot;Reading|2016-2023&quot;','data-root-name=&quot;Reading|2016-now&quot;')
rep('&lt;!-- ===== Reading (2016-2023) ===== --&gt;','&lt;!-- ===== Reading (2016-now) ===== --&gt;')

# Attribution Gradients after DiverseSumm
attr = '''
        &lt;article class=&quot;paper-entry&quot; data-id=&quot;attribution_gradients&quot; data-title=&quot;Attribution Gradients&quot; data-venue=&quot;UIST2026&quot;
            data-url=&quot;https://arxiv.org/abs/2510.00361&quot; data-parent=&quot;diverse_summ&quot;
            data-indirect-connections=&quot;answer_engine_eval, deeptrace&quot;
            data-coauthors=&quot;Hita Kambhamettu, Alyssa Hwang, Andrew Head&quot;
            data-full-title=&quot;Attribution Gradients: Incrementally Unfolding Citations for Critical Examination of Attributed AI Answers&quot;
            data-summary=&quot;Work led by Hita Kambhamettu. Citations in AI answers are only useful if readers actually check them, and checking them is costly. Attribution Gradients is a reading interface that incrementally unfolds the evidence behind each claim: supporting and contradicting excerpts, evidence counts, and even second-degree citations, all in place. Neat Finding: in a lab study, participants using the interface produced substantially higher-quality revisions of AI-generated answers.&quot;&gt;
        &lt;/article&gt;
'''
anchor = '            data-links-code_data=&quot;https://github.com/salesforce/DiverseSumm&quot;&gt;\n        &lt;/article&gt;\n'
rep(anchor, anchor + attr)

# Script: pass `latest` through, drop the old sign code (garden.js draws it now)
rep('&lt;script src=&quot;garden.js?v=3&quot;&gt;&lt;/script&gt;','&lt;script src=&quot;garden.js?v=4&quot;&gt;&lt;/script&gt;')
rep(&quot;            if ($el.data('is-left-child')) { paper.is_left_child = 1; }&quot;,
    &quot;            if ($el.data('is-left-child')) { paper.is_left_child = 1; }\n            if ($el.data('latest')) { paper.latest = 1; }&quot;)
start = s.index('        // Find the latest paper id')
end = s.index('        // Generate JSON-LD structured data')
s = s[:start] + '        build_garden(papers);\n\n' + s[end:]
open(p,'w').write(s)
EOF
